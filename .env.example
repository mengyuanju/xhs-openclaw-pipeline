# 运行 npm run auth:setup 生成会话密钥；管理员密码现保存在中心服务，旧哈希仅用于兼容升级。
XHS_ADMIN_PASSWORD_HASH=
XHS_SESSION_SECRET=

# 可选：允许通过局域网主机名访问，多个值以英文逗号分隔。私有 IP 无需填写。
XHS_ALLOWED_HOSTS=

# 生成引擎固定 CODEX，使用执行机上的 codex login（ChatGPT 订阅）。
# 后台已保存的 agentProvider 优先于此环境变量。迁移与真实验收步骤见 docs/codex-exec-migration.md。
XHS_AGENT_PROVIDER=CODEX
# 可选：Codex 原生可执行文件绝对路径；Windows 必须是 .exe，不能填 codex.cmd / codex.ps1。
XHS_CODEX_BIN=
# 同一主机、同一账号的所有项目/进程应使用同一状态库；默认在 CODEX_HOME/xhs-runtime/limits.sqlite。
# 不支持通过网络共享 SQLite 来实现跨主机调度。
XHS_CODEX_RUNTIME_DB=
# 同机共享的 Codex 调用许可，均允许 1–32；图片许可不得超过总许可。
# 同一状态库的所有调用进程必须使用一致配置；默认总计 2、图片 1。
XHS_CODEX_CONCURRENCY=2
XHS_CODEX_IMAGE_CONCURRENCY=1

# 分布式执行机的任务池容量，与上面的模型调用许可分别控制。
# 每类允许 1–32，默认各 1；修改后重启执行机。中心须先升级并支持 executorConcurrency。
EXECUTOR_COPY_CONCURRENCY=1
EXECUTOR_IMAGE_CONCURRENCY=1
# 生图开关独立于容量；true 才领取图片任务。
IMAGE_WORKER_ENABLED=false
# 空队列或暂时错误时的轮询间隔，1000–60000 毫秒；任务完成后立即尝试补位。
EXECUTOR_POLL_MS=5000

# Query 词包中审核通过的词会由独立的可见浏览器低频搜索，不进入模型 Prompt。
# 首次运行 `npm run xhs:login`，在 Edge 中手动登录后关闭窗口；不要在仓库中保存账号密码或 Cookie。
# 登录目录默认位于 LOCALAPPDATA/xhs-query-search/edge-profile，若覆盖必须使用仓库外的绝对路径。
XHS_SEARCH_PROFILE_DIR=
XHS_SEARCH_BROWSER_CHANNEL=msedge
XHS_SEARCH_NODE_ID=
XHS_SEARCH_NODE_NAME=
# 非敏感显示标签，用于管理员识别这台搜索节点登录的是哪个小红书账号。
XHS_SEARCH_ACCOUNT_LABEL=
# 中心服务器上运行搜索时填 CENTER；普通执行机填 EXECUTOR。
XHS_SEARCH_HOST_KIND=EXECUTOR
# 中心服务与搜索执行机共享的独立机器密钥（32–512 字符）；不要提交真实值。
XHS_SEARCH_MACHINE_TOKEN=
# 搜索间隔允许 3000–60000 毫秒；每个 Query 的链接数量由管理员在生产配置中统一设置。
XHS_SEARCH_POLL_MS=8000

# 独立文案正文生成提供方：CODEX 或 DOTS。
XHS_COPY_GENERATION_PROVIDER=CODEX

# 联网搜索提供方：DEEPSEEK 或 CODEX；仅影响文案检索，默认 DEEPSEEK。
XHS_WEB_SEARCH_PROVIDER=DEEPSEEK
# DeepSeek 搜索 Key 由使用者在执行服务的本机环境中提供，不要提交真实值。
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-v4-pro；也可填写经实测支持服务端 web_search 的合法模型 ID。
XHS_DEEPSEEK_SEARCH_MODEL=deepseek-v4-pro
XHS_DEEPSEEK_SEARCH_TIMEOUT_MS=120000

# Dots Chat Completions 基础配置。Key 只填写在本机 .env.local，禁止提交真实值。
XHS_DOTS_BASE_URL=https://note3-prev-api.askdiandian.com
XHS_DOTS_MODEL=dots3-note-prev
XHS_DOTS_API_KEY=

# 可选：文案模型；留空时使用项目当前默认值 openai/gpt-5.6-sol。
XHS_TEXT_MODEL=

# 主模型明确返回 Selected model is at capacity 后，文本、审核、视觉和检索调用使用该备用模型。
# 图片生成和改图的驱动模型不会降级。默认 openai/gpt-5.6-terra。
XHS_CAPACITY_FALLBACK_MODEL=
# 主模型满载后的模型级冷却时间，允许 60000–3600000 毫秒，默认 300000。
XHS_MODEL_CAPACITY_COOLDOWN_MS=

# 可选：Excel 预检测使用的文本模型；留空时沿用 XHS_TEXT_MODEL 或项目默认值。
XHS_SCREENING_MODEL=
XHS_REVIEW_MODEL=

# 可选：逐页 OCR/图文验收模型；留空时沿用 XHS_TEXT_MODEL。
XHS_VISION_MODEL=

# 可选：最终 0–3 分独立终审模型；建议与生成模型分开，留空时沿用 XHS_VISION_MODEL。
XHS_QUALITY_MODEL=

# 可选：生产任务完成分数门槛。默认 3；设为 2 时允许无阻断问题的人工复核候选完成。
XHS_MIN_COMPLETION_SCORE=3

# 可选：模型 HTTP(S) 代理；Codex 子进程使用该代理，不自动切换直连。
XHS_MODEL_PROXY_URL=

# 可选：用于 Codex 图片生成/编辑子进程的 HTTP(S) 代理。
XHS_IMAGE_PROXY_URL=

# 可选：首图完成后的任务内图片并发数，默认 2，仅允许 1–2；Codex 仍受共享图片许可约束。
XHS_IMAGE_CONCURRENCY=2

# 可选：drain 同时生产的完整任务数，默认 2，仅允许 1–2。并发为 2 时每任务图片并发自动降为 1。
XHS_TASK_CONCURRENCY=2

# 可选：单次图片生成/编辑超时（毫秒），默认 300000；允许 30000–540000。
XHS_IMAGE_TIMEOUT_MS=
