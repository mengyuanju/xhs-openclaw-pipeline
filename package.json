{
  "name": "xhs-codex-pipeline",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Distributed Xiaohongshu content production powered by Codex.",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "dev:lan": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3001",
    "start:lan": "next start -H 0.0.0.0 -p 3001",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix preview-service run typecheck",
    "db:init": "node src/cli.mjs init",
    "enqueue": "node src/cli.mjs enqueue",
    "status": "node src/cli.mjs status",
    "auth:setup": "node scripts/setup-admin.mjs",
    "agent:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/agent-runtime.mjs check",
    "agent:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/agent-runtime.mjs status",
    "agent:resume": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/agent-runtime.mjs resume",
    "prompts:install-rules": "node scripts/install-rule-prompts.mjs",
    "storage:optimize": "node scripts/optimize-storage.mjs",
    "db:backup": "node scripts/backup-local-database.mjs",
    "db:backup:all": "node scripts/backup-project-databases.mjs",
    "control-plane:migrate-local": "node --env-file-if-exists=.env scripts/migrate-local-global-data.mjs",
    "knowledge:migrate": "node --env-file-if-exists=.env scripts/migrate-knowledge.mjs",
    "server:db:export": "npm --prefix server run db:export --",
    "server:db:init": "npm --prefix server run db:init --",
    "server:db:upgrade": "npm --prefix server run db:upgrade --",
    "executor": "node --env-file-if-exists=.env src/executor/cli.mjs",
    "xhs:login": "node --env-file-if-exists=.env src/executor/xhs-search-cli.mjs --login",
    "xhs:search": "node --env-file-if-exists=.env src/executor/xhs-search-cli.mjs",
    "executor:deepseek-sim": "node --env-file-if-exists=.env src/executor/deepseek-simulator-cli.mjs",
    "worker": "node src/cli.mjs worker",
    "worker:drain": "node src/cli.mjs drain",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.4",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
