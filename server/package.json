{
  "name": "xhs-openclaw-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote task and global-data control plane for xhs-openclaw-pipeline.",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "init": "node src/cli.mjs init",
    "init:production": "node src/cli.mjs init --environment=production",
    "env:status": "node scripts/show-environment.mjs",
    "env:status:production": "node scripts/show-environment.mjs --environment=production",
    "db:export": "node scripts/export-database.mjs",
    "db:init": "node scripts/manage-database.mjs init",
    "db:migrate:base-config": "node scripts/migrate-base-configuration.mjs",
    "db:upgrade": "node scripts/manage-database.mjs upgrade",
    "start": "node src/cli.mjs serve",
    "start:production": "node src/cli.mjs serve --environment=production",
    "test": "node --test"
  },
  "dependencies": {
    "@excel.js/exceljs": "0.15.0",
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.7.0",
    "archiver": "^8.0.0",
    "jszip": "^3.10.1",
    "koa": "^3.2.1",
    "pg": "^8.23.0",
    "sharp": "0.35.4"
  }
}
